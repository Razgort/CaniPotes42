# Database
DATABASE_URL="postgresql://canifed:canifed@localhost:5432/canifed?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Authentication (used by API core guards - Story 1.2)
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production

# CORS (comma-separated origins allowed)
CORS_ORIGINS=http://localhost:4200

# Swagger (set to false in production)
SWAGGER_ENABLED=true

# Email Configuration (for invitation emails)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@canifed.app

# Frontend URL (for invitation deep links)
FRONTEND_URL=http://localhost:4200

# Cloudflare R2 File Storage (for document uploads, dog photos, chat images)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=canifed

# HelloAsso Payments (Story 9.3)
# Get credentials from https://dev.helloasso.com/
# Sandbox: https://api.helloasso-sandbox.com, Production: https://api.helloasso.com
# For local webhook testing: use ngrok to expose localhost:3000
# HELLOASSO_CLIENT_ID=your_helloasso_client_id
# HELLOASSO_CLIENT_SECRET=your_helloasso_client_secret
# HELLOASSO_ORG_SLUG=your_organization_slug
HELLOASSO_BASE_URL=https://api.helloasso-sandbox.com
# HELLOASSO_WEBHOOK_SECRET=your_hmac_webhook_secret

# Stripe Payments (Story 9.2+)
# Get keys from https://dashboard.stripe.com/apikeys
# For local webhook testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:4200/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:4200/payment/cancelled

# === Deployment (GitHub Actions secrets — NOT local) ===
# VERCEL_TOKEN=           ← Vercel deployment token
# VERCEL_ORG_ID=          ← Vercel org/team ID
# VERCEL_PROJECT_ID=      ← Vercel project ID (staging)
# VERCEL_PROJECT_ID_PROD= ← Vercel project ID (production, if separate)
# RENDER_DEPLOY_HOOK_STAGING= ← Render deploy hook URL
# RENDER_DEPLOY_HOOK_PROD=    ← Render deploy hook URL (production)
# DATABASE_URL_STAGING=   ← Neon staging connection string
# DATABASE_URL_PROD=      ← Neon production connection string
# STAGING_API_URL=        ← e.g. https://canifed-api-staging.onrender.com
# PROD_API_URL=           ← e.g. https://canifed-api.onrender.com

# --- Frontend (Vite) : optionnel en local ---
# Le fichier apps/frontend/.env.development fixe VITE_API_URL=http://localhost:3000/api pour que
# les requêtes partent vers le port de l’API (pas seulement localhost:4200 dans l’onglet Réseau).
# Sinon : proxy Vite (`/api` → PORT) — l’URL affichée reste alors http://localhost:4200/api/...
# VITE_API_PROXY_TARGET=http://localhost:3000
# Build / prod : URL absolue de l’API si besoin.
# VITE_API_URL=https://ton-api.example.com/api
